<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No splash animation and a background that matches the Compose surface, so
         cold start reads as instant rather than as a launch sequence. -->
    <style name="Theme.Now" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/now_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Now.Capture" parent="Theme.Now">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
