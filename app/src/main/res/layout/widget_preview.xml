<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the launcher's widget picker, before the widget is placed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20B0B0F"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today: 3 things"
        android:textColor="#ECECF3"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="○  Reply to the email"
        android:textColor="#ECECF3"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="○  Ten minutes of tidying"
        android:textColor="#ECECF3"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Later stays quiet"
        android:textColor="#9A9AAE"
        android:textSize="12sp" />
</LinearLayout>
